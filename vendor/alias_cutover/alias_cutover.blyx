// Keep a canonical URL active until the replacement target passes a probe for the same revision.
use std::cli;

pub fn alias_cutover_start() -> vector { [0, 0, 0] }

pub fn alias_cutover_step(snapshot: vector, event: str, value: f64) -> vector {
    if len(snapshot) != 3 { return []; }
    let phase = at(snapshot, 0);
    let saved = at(snapshot, 1);
    let previous = at(snapshot, 2);
    if !(phase >= 0.0 && phase < 4.0 && phase % 1.0 == 0.0 && previous >= 0.0 && previous < 6.0 && previous % 1.0 == 0.0 && saved >= 0.0 && saved <= 9007199254740991.0 && saved % 1.0 == 0.0) { return []; }
    if !(value >= 0.0 && value <= 1000000000.0 && value % 1.0 == 0.0) { return [phase, saved, 0]; }
    // idle
    if phase == 0.0 {
        if event == "propose" && value>0.0 {
            return [1, value, 1]; // probe_target
        }
    }
    // testing
    if phase == 1.0 {
        if event == "failed" && value==saved {
            return [0, 0.0, 2]; // keep_canonical
        }
        if event == "passed" && value==saved {
            return [2, saved, 3]; // stage_redirect
        }
    }
    // staged
    if phase == 2.0 {
        if event == "switch" && value==saved {
            return [3, saved, 4]; // enable_redirect
        }
    }
    // live
    if phase == 3.0 {
        if event == "rollback" && value==saved {
            return [0, 0.0, 5]; // restore_canonical
        }
    }
    [phase, saved, 0]
}

pub fn alias_cutover_command(snapshot: vector) -> str {
    if len(snapshot) != 3 { return "invalid"; }
    let action = at(snapshot, 2);
    if action == 0.0 { return "reject"; }
    if action == 1.0 { return "probe_target"; }
    if action == 2.0 { return "keep_canonical"; }
    if action == 3.0 { return "stage_redirect"; }
    if action == 4.0 { return "enable_redirect"; }
    if action == 5.0 { return "restore_canonical"; }
    "invalid"
}

// Stop at the first rejected event. No host effects run during replay.
pub fn alias_cutover_replay(events: arglist, values: vector) -> vector {
    if args_len(events) != len(values) { return []; }
    let mut state = alias_cutover_start();
    let mut i = 0;
    while i < len(values) {
        state = alias_cutover_step(state, args_at(events, i), at(values, i));
        if at(state, 2) == 0.0 { return []; }
        i += 1;
    }
    state
}
